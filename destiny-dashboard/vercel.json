{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/sync/daily",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/sync/warm-cache",
      "schedule": "0 10 * * *"
    }
  ]
}
